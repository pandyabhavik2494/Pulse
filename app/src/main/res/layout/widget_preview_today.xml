<?xml version="1.0" encoding="utf-8"?>
<!-- Widget picker preview for "Today" (2x2), sample data. RemoteViews-safe views only. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_card_bg"
    android:padding="6dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:contentDescription="@null"
        android:scaleType="fitCenter"
        android:src="@drawable/widget_ring_preview" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:shadowColor="#732EF2A8"
            android:shadowRadius="14"
            android:text="520"
            android:textColor="#FF2EF2A8"
            android:textSize="30dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:shadowColor="#732EF2A8"
            android:shadowRadius="10"
            android:text="kcal under"
            android:textColor="#FF2EF2A8"
            android:textSize="11dp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:fontFamily="sans-serif"
            android:maxLines="1"
            android:text="8,412 steps"
            android:textColor="#FF4DA8FF"
            android:textSize="11dp"
            android:textStyle="bold" />
    </LinearLayout>
</FrameLayout>
