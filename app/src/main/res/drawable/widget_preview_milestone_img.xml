<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="72dp" android:drawable="@drawable/widget_card_bg" />
    <item android:width="280dp" android:height="8dp" android:gravity="center">
        <shape android:shape="rectangle">
            <corners android:radius="99dp" />
            <solid android:color="#FF1C202A" />
        </shape>
    </item>
    <item android:width="140dp" android:height="8dp" android:gravity="center_vertical|left" android:left="20dp">
        <shape android:shape="rectangle">
            <corners android:radius="99dp" />
            <gradient android:angle="0" android:endColor="#FFFF7AD9" android:startColor="#FFB48CFF" />
        </shape>
    </item>
</layer-list>
