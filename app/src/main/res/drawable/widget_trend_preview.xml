<?xml version="1.0" encoding="utf-8"?>
<!-- A falling trend line in the journey gradient, for the Journey widget's picker image. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="60dp"
    android:viewportWidth="120"
    android:viewportHeight="60">
    <path
        android:pathData="M6,12 C30,16 40,26 60,30 C80,34 96,44 114,48"
        android:strokeLineCap="round"
        android:strokeWidth="5">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:endColor="#FFFF7AD9"
                android:endX="114"
                android:endY="0"
                android:startColor="#FFB48CFF"
                android:startX="6"
                android:startY="0"
                android:type="linear" />
        </aapt:attr>
    </path>
    <path
        android:fillColor="#FFFFFFFF"
        android:pathData="M114,48 m-5,0 a5,5 0 1,0 10,0 a5,5 0 1,0 -10,0" />
</vector>
